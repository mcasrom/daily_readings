# daily_news — Variables de entorno
# Copia este fichero a .env y rellena las claves

# Modo: test (usa Ollama local) o production (usa APIs)
export DAILY_NEWS_MODE=test

# Solo necesario en modo production:
# export GEMINI_API_KEY=tu_clave_gemini
# export GROQ_API_KEY=tu_clave_groq

# Opcional: override de modelos Ollama (modo test)
# export OLLAMA_HOST=http://localhost:11434
# export OLLAMA_EMBED_MODEL=mxbai-embed-large
# export OLLAMA_LLM_MODEL=qwen3:4b

# SSH deploy
# export DEPLOY_SERVER=viaje
